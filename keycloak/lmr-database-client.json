{
  "clientId": "lmr-database",
  "name": "LMR Database",
  "description": "Radio frequency database — signal observations, transmitters, direction finding.",
  "rootUrl": "https://lmrdb.commsplice.com",
  "baseUrl": "https://lmrdb.commsplice.com",
  "adminUrl": "",
  "enabled": true,
  "alwaysDisplayInConsole": false,
  "clientAuthenticatorType": "client-secret",
  "redirectUris": [
    "https://lmrdb.commsplice.com/auth/callback",
    "https://lmrdb.commsplice.com/auth/silent-renew",
    "http://localhost:5173/auth/callback",
    "http://localhost:5173/auth/silent-renew"
  ],
  "webOrigins": [
    "+"
  ],
  "notBefore": 0,
  "bearerOnly": false,
  "consentRequired": false,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "publicClient": true,
  "frontchannelLogout": true,
  "protocol": "openid-connect",
  "attributes": {
    "oidc.ciba.grant.enabled": "false",
    "oauth2.device.authorization.grant.enabled": "false",
    "backchannel.logout.session.required": "true",
    "backchannel.logout.revoke.offline.tokens": "false",
    "display.on.consent.screen": "false",
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://lmrdb.commsplice.com/*##http://localhost:5173/*",
    "client.use.lightweight.access.token.enabled": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "protocolMappers": [
    {
      "name": "lmr-database-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "lmr-database",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "false"
      }
    }
  ],
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "roles",
    "email"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ]
}
