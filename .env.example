# Copy to .env and customise as needed.
PG_DB=lmr
PG_USER=lmr
PG_PASSWORD=lmr
PG_PORT=5432
PGRAPHILE_PORT=5050

# Used by migration scripts (run from host)
PG_DSN=postgres://lmr:lmr@127.0.0.1:5432/lmr

# Auth (Keycloak) — consumed by apps/postgraphile to verify JWTs.
# Realm name is case-sensitive: "CommSplice", not "commsplice".
KEYCLOAK_ISSUER=https://auth.commsplice.com/realms/CommSplice
KEYCLOAK_AUDIENCE=lmr-database

# Frontend (apps/web) — Vite only exposes VITE_-prefixed vars to the SPA.
# Authority is identical to KEYCLOAK_ISSUER; oidc-client-ts discovers the
# rest via /.well-known/openid-configuration. Redirect URIs are derived at
# runtime from window.location.origin, so the same SPA works on localhost,
# the LAN IP, or production — each just needs to be in the Keycloak client's
# Valid Redirect URIs list (see keycloak/lmr-database-client.json).
VITE_KEYCLOAK_AUTHORITY=https://auth.commsplice.com/realms/CommSplice
VITE_KEYCLOAK_CLIENT_ID=lmr-database
