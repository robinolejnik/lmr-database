# ---- source data ----------------------------------------------------------
# Large xlsx imports live in data/ and are reproducible from the source
data/*.xlsx

# ---- generated artifacts --------------------------------------------------
# Regenerable by re-running the migration pipeline
db/init/01_schema.sql
db/init/02_constraints.sql
tools/migration/schema_report.json
tools/migration/plans.json
tools/migration/summary.txt

# Local CSV staging
/tmp/lmr-csv/

# ---- python ---------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- node / pnpm ----------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- typescript / build outputs ------------------------------------------
*.tsbuildinfo
dist/
build/
.turbo/

# ---- framework-specific caches -------------------------------------------
# TanStack Router temp / generated
apps/web/.tanstack/
apps/web/src/routeTree.gen.ts
# GraphQL Code Generator output (regenerate with `pnpm codegen`)
apps/web/src/gql/

# ---- env / secrets --------------------------------------------------------
.env
.env.local
.env.*.local

# ---- editor / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- docker ---------------------------------------------------------------
# Named volumes live outside the repo; nothing to ignore here, but if you
# ever bind-mount postgres data into the tree, add it here.

# ---- claude code ----------------------------------------------------------
# Per-developer Claude Code settings (permissions etc.)
.claude/
